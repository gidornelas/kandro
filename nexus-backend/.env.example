# ─── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://nexus:nexus@localhost:5433/nexus?schema=public"

# ─── Redis (Socket.io adapter, presence cache) ────────────
REDIS_URL="redis://localhost:6380"

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-random-64-char-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ─── Server ──────────────────────────────────────────────
PORT=3000
HOST="0.0.0.0"
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# ─── Cloudflare R2 (S3-compatible) ───────────────────────
R2_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET="nexus-uploads"
R2_PUBLIC_URL="https://pub-<hash>.r2.dev"
R2_SIGNED_URL_TTL="900"    # 15 minutes in seconds

# ─── LiveKit (Voice/Video) ───────────────────────────────
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-secret"
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_TOKEN_TTL="21600"  # 6 hours in seconds

# ─── Railway (used at deploy time) ───────────────────────
RAILWAY_ENVIRONMENT="production"
